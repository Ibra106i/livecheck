# Env for the standalone scan worker (worker/), the container that claims queued
# scan jobs, runs the shared engine, records reports, and sends alerts.
# Copy to .env locally; set these in your container host (Fly.io / Cloud Run / Railway).

# --- Supabase (required) ------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Push + email (optional; sends are skipped when unset) -------------------
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
RESEND_API_KEY=
RESEND_FROM=

# --- Runtime tuning (all optional; defaults shown in comments) ---------------
# Concurrent claim loops. Bounds how many scans run in parallel. (default 2)
WORKER_CONCURRENCY=2
# Poll interval in ms when no job is available. (default 3000)
WORKER_POLL_MS=3000
# Hard per-job timeout in ms. (default 90000)
WORKER_JOB_TIMEOUT_MS=90000
# Attempts before a job is marked failed and its credit refunded. (default 2)
WORKER_MAX_ATTEMPTS=2
