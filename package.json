{
  "name": "livecheck",
  "version": "0.1.0",
  "description": "Run a fixed technical checklist against any deployed website and get a scored, timestamped report.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "livecheck": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "verify": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "website-audit",
    "seo",
    "ssl",
    "performance",
    "lighthouse",
    "cli"
  ],
  "dependencies": {
    "cheerio": "^1.0.0",
    "commander": "^14.0.0",
    "picocolors": "^1.1.1",
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.0",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
