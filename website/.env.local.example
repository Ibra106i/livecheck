# Clerk Auth (Required)
VITE_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...
CLERK_WEBHOOK_SECRET=whsec_...

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App
SITE_ORIGIN=https://livechecks.vercel.app
VITE_API_URL=

# Google Play Billing (plan section 6)
# Full service-account JSON from Google Cloud, on one line (needs Android Publisher access).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=
GOOGLE_PLAY_PACKAGE_NAME=app.livecheck
# Audience the RTDN Pub/Sub push is verified against (the subscription name).
RTDN_AUDIENCE=

# Push notifications — FCM HTTP v1 (plan section 10)
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=

# Email — Resend (plan section 17)
RESEND_API_KEY=
RESEND_FROM=

# Reviewer console allowlist (plan section 9): comma-separated Clerk emails.
# Empty = the console denies every request.
REVIEWER_EMAILS=

# Legacy password/session auth + SSO (only if those flows are enabled)
JWT_SECRET=
SSO_APP_URL=
SSO_ENCRYPTION_KEY=

# Local convenience: let the frontend use bundled sample data instead of live scans.
VITE_DEMO_MODE=false
