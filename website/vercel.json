{
  "env": {
    "SITE_ORIGIN": "https://livechecks.vercel.app"
  },
  "rewrites": [
    {
      "source": "/api/scans/:id",
      "destination": "/api/scans"
    },
    {
      "source": "/api/organizations/:id/members/:user_id",
      "destination": "/api/organizations"
    },
    {
      "source": "/api/organizations/:id/members",
      "destination": "/api/organizations"
    },
    {
      "source": "/api/invitations/accept/:token",
      "destination": "/api/invitations"
    }
  ]
}
